# Von https://dev.twitch.tv/console/apps (OAuth Redirect URL: http://localhost:3000/auth/callback)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Name und Preis des Kanalpunkte-Rewards (wird beim ersten Start automatisch angelegt)
REWARD_TITLE=Check-in
REWARD_COST=1

PORT=3000
TIMEZONE=Europe/Berlin
# Der Stream-Tag wechselt um diese Uhrzeit (Streams nach Mitternacht zählen zum Vortag)
DAY_ROLLOVER_HOUR=5

# Platzhalter: {user} {count}
CHAT_TEMPLATE=✅ {user} ist eingecheckt – du warst jetzt schon {count}x dabei! 🎉
DUPLICATE_TEMPLATE={user}, du bist heute schon eingecheckt (Besuch #{count}) ✅ Deine Punkte bekommst du zurück.

# Gemeinsames Geheimwort mit dem VerwirrBot für die Konto-Verknüpfung (langer Zufallstext). Ohne ihn ist die Community-Rangliste aus.
LINK_SECRET=
